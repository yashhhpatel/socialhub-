// SocialHub — Prisma schema
//
// Models are introduced incrementally, milestone by milestone, rather than
// all at once — see docs/database/SocialHub_Database_Design.md for the
// full target schema this grows into.
//
// Milestone 1.2 adds Organization, plus orgId/role on User. Organization
// only carries the fields needed so far (name, planTier, requiresApproval)
// — relations to BrandKit/SsoConfig/etc. are added in the milestones that
// introduce those models, not stubbed in now.
//
// Milestone 2.2 adds SocialAccount. Platform enum values match
// PlatformName exactly (see social-accounts/adapters/adapter.interface.ts)
// — that file's comment already flagged this alignment back in 2.1.
//
// Milestone 3.1 adds ContentAsset. Deliberately NOT included yet:
// templateId/brandKitId — those FKs reference Template/BrandKit models
// that don't exist until Phase 9, same reasoning as every other deferred
// FK in this file (User.orgId before Organization existed, etc.).
// approvalStatus IS included now despite approval enforcement itself not
// arriving until Milestone 13.2 — every asset has some approval state
// from creation regardless of whether an org requires approval, so this
// isn't a forward FK dependency the way templateId/brandKitId are.
//
// NOTE (Prisma 7+): the datasource `url` no longer lives here — Prisma 7
// moved connection URLs to prisma.config.ts (see ../prisma.config.ts).
// schema.prisma is now purely structural (models + provider), never
// environment-dependent. See https://pris.ly/d/config-datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  free
  starter
  pro
  enterprise
}

enum UserRole {
  owner
  admin
  editor
  viewer
}

enum Platform {
  instagram
  facebook
  threads
  x
  linkedin
}

/// Lifecycle of a per-platform rendition. `pending` exists because
/// generation becomes asynchronous in Phase 7 (queue-backed); until then
/// variants reach `ready` within the same request.
enum VariantStatus {
  pending
  ready
  failed
}

/// AI features metered against an org's plan quota (Milestone 5.2).
/// Mirrors docs/SocialHub_Database_Design.md §6.
enum AIFeature {
  caption
  hashtags
  tone
  viral_score
  best_time
}

/// Lifecycle of one publish attempt. `queued`/`scheduled` exist for
/// Phase 7's queue; Milestone 4.2 publishes synchronously, so a job goes
/// processing -> published|failed inside the request.
enum PublishJobStatus {
  queued
  scheduled
  processing
  published
  failed
  cancelled
}

enum SocialAccountStatus {
  connected
  expired
  revoked
  error
}

enum ContentAssetType {
  image
  video
}

enum ApprovalStatus {
  draft
  pending_approval
  approved
  rejected
}

model Organization {
  id               String          @id @default(uuid())
  name             String
  planTier         PlanTier        @default(free)
  requiresApproval Boolean         @default(false)
  users            User[]
  socialAccounts   SocialAccount[]
  contentAssets    ContentAsset[]
  aiUsageLogs      AIUsageLog[]
  brandKit         BrandKit?
  templates        Template[]
  invites          Invite[]
  ssoConfig        SsoConfig?
  createdAt        DateTime        @default(now())

  @@map("organization")
}

/// SAML SSO configuration for an enterprise org (Milestone 15.1). One per
/// org (orgId unique). Holds the IdP's SSO URL and signing certificate plus
/// the SP issuer/entity-id this app presents — everything needed to build a
/// login redirect and validate the SAMLResponse. `enabled` lets an org keep
/// config staged without forcing SSO on before it's verified.
model SsoConfig {
  id           String       @id @default(uuid())
  orgId        String       @unique
  organization Organization @relation(fields: [orgId], references: [id])
  enabled      Boolean      @default(true)
  /// IdP Single Sign-On URL (where the login AuthnRequest is sent).
  entryPoint   String
  /// IdP X.509 signing certificate (PEM body), used to verify assertions.
  idpCert      String
  /// This app's SP entity id / issuer, as registered with the IdP.
  issuer       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("sso_config")
}

enum InviteStatus {
  pending
  accepted
  revoked
}

/// A pending invitation for someone to join an org at a given role
/// (Milestone 11.1).
///
/// Only a HASH of the invite token is stored — the raw token lives solely in
/// the emailed accept link, exactly as RefreshToken does it, so a database
/// leak never yields a usable invite. Acceptance is single-use (status flips
/// to accepted) and time-bounded (expiresAt). The role is captured at invite
/// time, capped to the inviter's own rank by the service.
model Invite {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  email        String
  role         UserRole
  tokenHash    String       @unique
  status       InviteStatus @default(pending)
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId, status])
  @@map("invite")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(editor)
  orgId         String
  organization  Organization   @relation(fields: [orgId], references: [id])
  refreshTokens RefreshToken[]
  createdAssets ContentAsset[] @relation("CreatedAssets")
  comments      Comment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orgId])
  @@map("user")
}

/// A comment on a design (Milestone 13.1) — the collaboration thread teams
/// use to give feedback before approving. Cascade-deleted with the asset;
/// the author is Restrict-deleted (kept in the schema via onDelete default)
/// so a comment's attribution survives, and org-scoping is enforced through
/// the asset (a comment has no orgId of its own — it belongs to exactly one
/// asset, which belongs to one org).
model Comment {
  id        String       @id @default(uuid())
  assetId   String
  asset     ContentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime     @default(now())

  @@index([assetId, createdAt])
  @@map("comment")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, revoked])
  @@map("refresh_token")
}

model SocialAccount {
  id                String              @id @default(uuid())
  orgId             String
  organization      Organization        @relation(fields: [orgId], references: [id])
  platform          Platform
  externalAccountId String
  // Encrypted via TokenEncryptionService (Milestone 2.1) before ever
  // touching the database — never stored raw. See social-accounts.service.ts.
  accessTokenEnc    String
  refreshTokenEnc   String?
  expiresAt         DateTime?
  status            SocialAccountStatus @default(connected)
  publishJobs       PublishJob[]
  createdAt         DateTime            @default(now())

  // Prevents the same external Instagram/X/etc. account being connected
  // twice to one org.
  @@unique([orgId, platform, externalAccountId])
  @@index([orgId])
  @@map("social_account")
}

model ContentAsset {
  id             String           @id @default(uuid())
  orgId          String
  organization   Organization     @relation(fields: [orgId], references: [id])
  createdById    String
  createdBy      User             @relation("CreatedAssets", fields: [createdById], references: [id])
  type           ContentAssetType
  // Arbitrary editor canvas state (width/height/layers/etc.) — schema
  // owned by the editor (Milestone 3.3+), not by this model. Validated
  // at the API boundary (see content/dto/canvas-json.dto.ts), not by
  // the database.
  canvasJson     Json
  // Flattened render of canvasJson, produced by the editor (which owns
  // the canvas rendering engine) and uploaded via POST
  // /content/assets/upload. Variant generation crops/resizes THIS, per
  // platform — the backend never rasterizes canvasJson itself, which
  // would mean maintaining a second rendering engine that could
  // visually diverge from the one users actually see.
  //
  // publicId is stored alongside the URL because Cloudinary
  // transformations are addressed by public id, not by parsing a
  // delivery URL apart.
  masterImageUrl      String?
  masterImagePublicId String?
  approvalStatus ApprovalStatus   @default(draft)
  variants       ContentVariant[]
  comments       Comment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([orgId])
  @@index([orgId, approvalStatus])
  @@map("content_asset")
}

/// Per-platform rendition of a ContentAsset — the "publish everywhere"
/// fan-out described in docs/SocialHub_Database_Design.md §Relationships.
/// One asset produces N variants, and analytics later attribute back
/// through this row to the original asset.
model ContentVariant {
  id               String        @id @default(uuid())
  assetId          String
  asset            ContentAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  platform         Platform
  renderedMediaUrl String?
  caption          String?
  hashtags         String?
  status           VariantStatus @default(pending)
  publishJobs      PublishJob[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Not in the database-design doc, which specifies only @@index([assetId]).
  // Added because regenerating variants for an asset must UPDATE the
  // existing row per platform rather than accumulate duplicates — without
  // this constraint, pressing "generate" twice would silently create two
  // Instagram variants and leave publish targeting ambiguous.
  @@unique([assetId, platform])
  @@index([assetId])
  @@map("content_variant")
}

/// One publish attempt of one variant to one connected account
/// (Milestone 4.2).
///
/// A row per ATTEMPT, not per variant — republishing or rescheduling
/// creates a new job rather than mutating the old one, so the full
/// history of what was sent where, and what happened, is preserved. That
/// history is what analytics attribution (Phase 10) walks back through.
model PublishJob {
  id              String           @id @default(uuid())
  variantId       String
  variant         ContentVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  socialAccountId String
  // Restrict, not Cascade: disconnecting an account must not silently
  // delete the record of everything ever published through it.
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  scheduledAt     DateTime?
  // The caption to post with (Milestone 7.3). Persisted on the row because
  // a scheduled job is not enqueued until it comes due — possibly days
  // later — so the caption the user chose has to survive here rather than
  // in a BullMQ payload that doesn't exist yet. The cron reads it when it
  // enqueues the due job. Null for an immediate publish, whose caption
  // rides straight in the job data.
  caption         String?
  status          PublishJobStatus @default(queued)
  attemptCount    Int              @default(0)
  lastError       String?
  /// The platform's own id for the created post — the join key analytics
  /// needs to pull metrics back for it (Phase 10).
  externalPostId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  postMetric      PostMetric?

  @@index([status, scheduledAt])
  @@index([variantId])
  @@map("publish_job")
}

/// A normalized snapshot of one published post's performance (Phase 10).
///
/// One row per published post (unique publishJobId), refreshed in place on
/// each scheduled pull — capturedAt records when it was last read. The
/// fields are CANONICAL: each platform's insights payload is mapped into
/// this one shape by the ingestion normalizers, so the dashboard queries a
/// single schema regardless of which network a post lives on. Snapshots
/// (rather than time-series history) keep the table bounded; trend-over-time
/// is a later refinement.
model PostMetric {
  id           String     @id @default(uuid())
  publishJobId String     @unique
  publishJob   PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  impressions  Int        @default(0)
  reach        Int        @default(0)
  likes        Int        @default(0)
  comments     Int        @default(0)
  shares       Int        @default(0)
  clicks       Int        @default(0)
  /// When these numbers were last pulled from the platform.
  capturedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("post_metric")
}

enum IngestionStatus {
  running
  success
  failed
}

/// Tracks each scheduled analytics pull (Phase 10): when it ran, how many
/// posts it refreshed or failed on, and any fatal error. Gives the
/// dashboard a trustworthy "last updated" and makes a broken pull
/// diagnosable instead of silent.
model IngestionRun {
  id             String          @id @default(uuid())
  status         IngestionStatus @default(running)
  postsProcessed Int             @default(0)
  postsFailed    Int             @default(0)
  error          String?
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  @@index([startedAt])
  @@map("ingestion_run")
}

/// Per-org AI consumption, one row per generation (Milestone 5.1).
///
/// Written on SUCCESS only. A failed provider call costs the org nothing,
/// so charging quota for it would let an outage silently burn a customer's
/// monthly allowance — see AiGatewayService.
///
/// Token counts are recorded per call rather than derived later: the
/// provider reports actual usage (including cache reads), and that number
/// cannot be reconstructed from the prompt afterwards.
model AIUsageLog {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  userId       String?
  feature      AIFeature
  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  /// The model that served the request — kept so a later cost analysis can
  /// price historical usage correctly after a model migration.
  model        String
  createdAt    DateTime     @default(now())

  // Composite, in this order, because every quota question is
  // "how much has THIS org used SINCE some point" — org first narrows to
  // the tenant, createdAt then serves the window as a range scan.
  @@index([orgId, createdAt])
  @@map("ai_usage_log")
}

/// One brand kit per org (Milestone 9.3): the reusable colours, fonts and
/// logo applied across designs. Modelled 1:1 with Organization (orgId is
/// unique) because "your brand" is a single thing per tenant, not a
/// collection — a multi-brand/sub-brand model would be a different feature.
///
/// colors/fonts are plain string arrays (hex values and font-family names)
/// rather than their own tables: they are an unordered-ish small list edited
/// as a whole in the brand-kit editor, never queried or joined individually,
/// so a Postgres text[] is the right weight. The logo is a Cloudinary URL +
/// publicId, the same shape ContentAsset already uses for uploaded media.
model BrandKit {
  id           String       @id @default(uuid())
  orgId        String       @unique
  organization Organization @relation(fields: [orgId], references: [id])
  colors       String[]     @default([])
  fonts        String[]     @default([])
  logoUrl      String?
  logoPublicId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("brand_kit")
}

/// A reusable design an org can start new content from (Milestone 9.4).
///
/// canvasJson is the same editor-owned payload ContentAsset stores — a
/// template is essentially a saved starting canvas. "Start from template"
/// copies this into a new ContentAsset via the existing content-creation
/// endpoint, so templates need no rendering/publishing machinery of their
/// own; they are a source to clone, not a thing that gets published.
///
/// Org-scoped (each tenant curates its own library). thumbnailUrl is an
/// optional preview render; category is a freeform grouping label for the
/// gallery, indexed with orgId so "this org's templates in this category"
/// is a single range scan.
model Template {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  category     String?
  canvasJson   Json
  thumbnailUrl String?
  // Marketplace (Milestone 14.1). isPublic makes a template discoverable by
  // any org via GET /templates/marketplace; publishedById records who
  // published it (provenance — deliberately not exposed cross-org). A clone
  // is always created private (isPublic=false) in the cloning org.
  isPublic      Boolean     @default(false)
  publishedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId, category])
  // Serves the marketplace listing: public templates, optionally by category.
  @@index([isPublic, category])
  @@map("template")
}
