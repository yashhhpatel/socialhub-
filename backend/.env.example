# Copy to .env and fill in real values for local development.
# Every variable here is validated at boot by src/config — the app refuses
# to start if a required one is missing or malformed (see env.validation.ts).

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://socialhub:socialhub@localhost:5432/socialhub

# --- Auth (JWT) ---
# Generate a real secret locally, never reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_generated_64_char_hex_secret_before_running
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- Token encryption (Milestone 2.1) ---
# MUST be exactly 32 bytes hex-encoded (64 hex chars) — TokenEncryptionService
# validates this exact length at boot. Generate a real one locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_a_generated_64_char_hex_key_before_running

# --- Instagram OAuth (Milestone 2.2) ---
# From your Meta Developer App dashboard (developers.facebook.com) —
# "Business Login for Instagram" product, NOT the deprecated Basic
# Display API. See src/social-accounts/adapters/instagram.adapter.ts.
#
# UNLIKE every variable above, these are deliberately NOT added to
# env.validation.ts's required schema — connecting Instagram is an
# optional feature a dev may not have Meta credentials for yet, and the
# rest of the app (auth, health, etc.) has no reason to refuse to boot
# over it. Missing/invalid values here fail loudly but lazily, only when
# someone actually attempts POST /social-accounts/instagram/connect —
# see InstagramAdapter's use of configService.getOrThrow() inside its
# methods, not its constructor.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/social-accounts/instagram/callback

# --- X (Twitter) OAuth (Milestone 2.3) ---
# From your X Developer Portal app (developer.x.com) — OAuth 2.0 with
# PKCE. See src/social-accounts/adapters/x.adapter.ts. Same reasoning as
# the Instagram vars above: deliberately NOT boot-required.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/social-accounts/x/callback

# --- Facebook OAuth (Milestone 8.1) ---
# From your Meta Developer App dashboard (developers.facebook.com) —
# "Facebook Login" product with the pages_manage_posts / pages_show_list
# permissions. See src/social-accounts/adapters/facebook.adapter.ts. Same
# reasoning as the Instagram/X vars above: deliberately NOT boot-required —
# missing values fail loudly but lazily, only on POST
# /social-accounts/facebook/connect.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/social-accounts/facebook/callback

# --- Threads OAuth (Milestone 8.2) ---
# From your Meta Developer App dashboard (developers.facebook.com) — the
# "Threads API" use case (threads_basic / threads_content_publish). See
# src/social-accounts/adapters/threads.adapter.ts. Same reasoning as the
# Instagram/X/Facebook vars above: deliberately NOT boot-required — missing
# values fail loudly but lazily, only on POST
# /social-accounts/threads/connect.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/social-accounts/threads/callback

# --- LinkedIn OAuth (Milestone 8.3) ---
# From your LinkedIn Developer app (developer.linkedin.com) — "Sign In with
# LinkedIn using OpenID Connect" plus the "Share on LinkedIn" (w_member_social)
# product. See src/social-accounts/adapters/linkedin.adapter.ts. Same
# reasoning as the vars above: deliberately NOT boot-required — missing
# values fail loudly but lazily, only on POST
# /social-accounts/linkedin/connect.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/social-accounts/linkedin/callback

# --- Frontend URL (Milestone 2.4) ---
# Used only to redirect the browser back to the app after an OAuth
# callback completes (see social-accounts.controller.ts). Optional — if
# unset, the callback returns plain JSON instead of redirecting, which
# still works fine for testing the API directly via curl/Postman.
#
# Flutter Web's local dev server picks a RANDOM port by default
# (`flutter run -d chrome`), so there's no universal correct value here.
# Run with a fixed port to make this useful locally:
#   flutter run -d chrome --web-port=5000
# then:
# FRONTEND_URL=http://localhost:5000
FRONTEND_URL=

# --- Cloudinary (Milestone 3.2) ---
# From your Cloudinary dashboard (cloudinary.com/console). Same reasoning
# as the OAuth vars above: deliberately NOT boot-required — media upload
# is an optional feature a dev may not have Cloudinary credentials for
# yet. An upload attempt without these configured fails with a clear
# Cloudinary API error at call time, not a cryptic one.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (Phase 5) ---
# Anthropic API key for caption generation and the rest of the AI suite.
# Optional at boot, like the Cloudinary and OAuth credentials: the server
# starts without it, and AI endpoints return 503 with a clear message until
# it's set. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Error monitoring / Sentry (Milestone 6.3) ---
# Sentry DSN for backend error reporting. Optional at boot, like the
# Cloudinary/OAuth/Anthropic credentials above: without it the server runs
# and simply reports nothing. On staging/production this is set as a real
# platform environment variable. Create a project at https://sentry.io and
# copy its DSN here.
SENTRY_DSN=

# --- Redis / queues (Milestone 7.1) ---
# Backs the BullMQ publish and schedule queues. These defaults match the
# docker-compose Redis service (`docker compose up redis`), so local dev
# needs no override. Staging/production set them as real platform env vars.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional — local Redis has no password; a managed instance will.
REDIS_PASSWORD=

# --- Transactional email (Milestone 11.1) ---
# Used to send team-invite emails via SendGrid's HTTP API. Optional at boot,
# like the credentials above: when unset, InvitesService logs the accept link
# instead of sending — so the invite flow is fully testable locally without
# an email provider. EMAIL_FROM must be a verified sender on the account.
SENDGRID_API_KEY=
EMAIL_FROM=
